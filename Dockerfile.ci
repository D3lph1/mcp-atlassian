# The image CI publishes to GHCR (DECISIONS.md D47).
#
# Nothing is compiled here: the binary is the static musl artifact the
# `build` matrix already produced natively for this architecture, so a
# multi-platform build needs no QEMU. `Dockerfile` is the self-contained
# variant for a local `docker build`; keep the two runtime stages the same.
FROM scratch
ARG TARGETARCH
COPY --chmod=0755 dist/mcp-atlassian-${TARGETARCH} /mcp-atlassian
# No root inside the container; nothing here needs it.
USER 65534:65534
ENTRYPOINT ["/mcp-atlassian"]
